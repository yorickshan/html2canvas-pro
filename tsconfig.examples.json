{
    "compilerOptions": {
        "noImplicitAny": true,
        "noImplicitThis": true,
        "strictNullChecks": true,
        "noUncheckedIndexedAccess": true,
        "target": "es2022",
        "module": "esnext",
        "lib": ["es2022", "dom", "dom.iterable"],
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noEmit": true,
        "paths": {
            "html2canvas-pro": ["./dist/types/index.d.ts"]
        }
    },
    "include": ["examples"]
}
